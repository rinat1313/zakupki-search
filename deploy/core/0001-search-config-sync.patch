diff --git a/internal/store/search_sync.go b/internal/store/search_sync.go
new file mode 100644
index 0000000..7399895
--- /dev/null
+++ b/internal/store/search_sync.go
@@ -0,0 +1,87 @@
+package store
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/google/uuid"
+)
+
+// SearchSyncItem — минимальный хит из zakupki-search / EIS.
+type SearchSyncItem struct {
+	RegNumber  string `json:"reg_number"`
+	SourceSite string `json:"source_site,omitempty"`
+	NoticeURL  string `json:"notice_url,omitempty"`
+	Law        string `json:"law,omitempty"`
+	ObjectName string `json:"object_name,omitempty"`
+}
+
+type SearchSyncResult struct {
+	CategoryID   uuid.UUID  `json:"category_id"`
+	Upserted     int        `json:"upserted"`
+	Enqueued     int        `json:"enqueued"`
+	JobID        *uuid.UUID `json:"job_id,omitempty"`
+	ConfigVersion int64     `json:"config_version"`
+}
+
+// SyncSearchConfig upserts tenders for a searcher category and optionally enqueues ingest.
+func (s *Store) SyncSearchConfig(ctx context.Context, searchConfigID uuid.UUID, title string, configVersion int64, items []SearchSyncItem, enqueue bool) (*SearchSyncResult, error) {
+	cat, err := s.EnsureCategoryForSearchConfig(ctx, searchConfigID, title)
+	if err != nil {
+		return nil, err
+	}
+
+	upserted := 0
+	ingestItems := make([]struct{ Reg, Site string }, 0, len(items))
+	for _, it := range items {
+		reg := strings.TrimSpace(it.RegNumber)
+		if reg == "" {
+			continue
+		}
+		site := strings.TrimSpace(it.SourceSite)
+		if site == "" {
+			site = "https://zakupki.gov.ru"
+		}
+		payload := json.RawMessage(`{}`)
+		if strings.TrimSpace(it.NoticeURL) != "" {
+			b, _ := json.Marshal(map[string]any{"notice_url": it.NoticeURL, "search_config_id": searchConfigID.String()})
+			payload = b
+		}
+		_, _, err := s.UpsertTender(ctx, TenderUpsertInput{
+			RegNumber:  reg,
+			SourceSite: site,
+			Law:        it.Law,
+			ObjectName: it.ObjectName,
+			Payload:    payload,
+			CategoryID: cat.ID,
+		})
+		if err != nil {
+			return nil, fmt.Errorf("upsert %s: %w", reg, err)
+		}
+		upserted++
+		ingestItems = append(ingestItems, struct{ Reg, Site string }{Reg: reg, Site: site})
+	}
+
+	if configVersion > 0 {
+		_, _ = s.Pool.Exec(ctx,
+			`UPDATE categories SET synced_config_version=$2 WHERE id=$1`,
+			cat.ID, configVersion)
+	}
+
+	out := &SearchSyncResult{
+		CategoryID:    cat.ID,
+		Upserted:      upserted,
+		ConfigVersion: configVersion,
+	}
+	if enqueue && len(ingestItems) > 0 {
+		job, err := s.CreateIngestJob(ctx, cat.ID, "search-sync", ingestItems)
+		if err != nil {
+			return nil, fmt.Errorf("enqueue ingest: %w", err)
+		}
+		out.Enqueued = len(ingestItems)
+		out.JobID = &job.ID
+	}
+	return out, nil
+}
